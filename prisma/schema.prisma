// Curated — data model
//
// Two concerns live in this schema:
//   1. Application state (users, playlists, bucket lists, history, events).
//   2. A local catalogue cache of media fetched from Spotify / TMDB, enriched
//      with an LLM-friendly document and a pgvector embedding.
//
// The embedding column is declared `Unsupported` because Prisma has no native
// vector type; all vector reads/writes go through raw SQL in
// src/server/vector/store.ts.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Domain {
  MUSIC
  VIDEO
}

enum MediaType {
  TRACK
  MOVIE
  SERIES
}

enum CollectionSource {
  MANUAL
  AI
  SEARCH
}

enum EventAction {
  SHOWN
  OPENED
  SAVED
  REMOVED
  DISMISSED
  WATCHED
}

enum JobStatus {
  RUNNING
  SUCCESS
  FAILED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  preferences UserPreference?
  playlists   Playlist[]
  bucketLists BucketList[]
  searches    SearchHistory[]
  events      RecommendationEvent[]

  @@map("users")
}

model UserPreference {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  personalizationEnabled  Boolean  @default(true)
  favoriteMusicGenres     String[] @default([])
  favoriteVideoGenres     String[] @default([])
  favoriteMoods           String[] @default([])
  avoidedGenres           String[] @default([])
  languages               String[] @default(["en"])
  maxRuntimeMinutes       Int?
  familyFriendlyOnly      Boolean  @default(false)
  preferredTone           String?
  // Learned affinity scores, e.g. { "video:genre:sci-fi": 3.5, "music:mood:calm": 2 }
  affinity                Json     @default("{}")
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ---------------------------------------------------------------------------
// Music curation
// ---------------------------------------------------------------------------

model Playlist {
  id          String           @id @default(cuid())
  userId      String
  name        String
  description String           @default("")
  source      CollectionSource @default(MANUAL)
  // The natural-language query a playlist was generated from, when it came
  // out of the discovery agent. Lets the user re-run / refresh the list.
  seedQuery   String?
  accent      String           @default("violet")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items PlaylistItem[]

  @@index([userId, updatedAt])
  @@map("playlists")
}

model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  mediaId    String
  position   Int
  note       String?
  // Denormalised copy of the track so a saved playlist renders even if the
  // catalogue cache is pruned or the upstream API is unavailable.
  snapshot   Json
  addedAt    DateTime @default(now())

  playlist Playlist   @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  media    MediaItem? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@unique([playlistId, mediaId])
  @@index([playlistId, position])
  @@index([mediaId])
  @@map("playlist_items")
}

// ---------------------------------------------------------------------------
// Movie & series curation
// ---------------------------------------------------------------------------

model BucketList {
  id          String           @id @default(cuid())
  userId      String
  name        String
  description String           @default("")
  source      CollectionSource @default(MANUAL)
  seedQuery   String?
  accent      String           @default("amber")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items BucketListItem[]

  @@index([userId, updatedAt])
  @@map("bucket_lists")
}

model BucketListItem {
  id           String    @id @default(cuid())
  bucketListId String
  mediaId      String
  mediaType    MediaType
  position     Int
  watched      Boolean   @default(false)
  watchedAt    DateTime?
  note         String?
  snapshot     Json
  addedAt      DateTime  @default(now())

  bucketList BucketList @relation(fields: [bucketListId], references: [id], onDelete: Cascade)
  media      MediaItem? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@unique([bucketListId, mediaId])
  @@index([bucketListId, position])
  @@index([mediaId])
  @@map("bucket_list_items")
}

// ---------------------------------------------------------------------------
// Catalogue cache + embeddings
// ---------------------------------------------------------------------------

model MediaItem {
  // Namespaced id: "spotify:track:6WrI0LAC5M1Rw2MnX2ZvEg", "tmdb:movie:157336",
  // "seed:track:levitating". Stable across refreshes.
  id          String    @id
  domain      Domain
  mediaType   MediaType
  title       String
  subtitle    String    @default("") // artist(s) for music, tagline for video
  album       String?
  description String    @default("")
  imageUrl    String?
  externalUrl String?
  releaseDate DateTime?
  releaseYear Int?
  popularity  Float     @default(0)
  rating      Float?
  voteCount   Int?
  runtimeMin  Int?
  seasons     Int?
  episodes    Int?
  language    String    @default("en")
  adult       Boolean   @default(false)
  genres      String[]  @default([])
  moods       String[]  @default([])
  themes      String[]  @default([])
  tags        String[]  @default([])
  // Music audio features, 0..1 unless noted. Null for video.
  energy       Float?
  danceability Float?
  valence      Float?
  acousticness Float?
  tempo        Float?
  // Video narrative descriptors.
  tone       String?
  pacing     String?
  intensity  String?

  // The enriched natural-language document that gets embedded.
  document    String  @default("")
  // sha256 of the document; embeddings are only regenerated when it changes.
  contentHash String  @default("")
  embedding   Unsupported("vector(768)")?
  embeddedAt  DateTime?
  embedModel  String?

  source    String   @default("seed") // "spotify" | "tmdb" | "seed"
  raw       Json?
  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playlistItems   PlaylistItem[]
  bucketListItems BucketListItem[]
  chartEntries    ChartEntry[]

  @@index([domain, mediaType])
  @@index([domain, popularity])
  @@index([contentHash])
  @@map("media_items")
}

// ---------------------------------------------------------------------------
// Charts (Top 50 and friends)
// ---------------------------------------------------------------------------

model ChartSnapshot {
  id          String   @id @default(cuid())
  chartId     String // "top-50-pop"
  // Calendar month the snapshot belongs to, "YYYY-MM".
  period      String
  label       String
  source      String   @default("seed")
  itemCount   Int      @default(0)
  generatedAt DateTime @default(now())

  entries ChartEntry[]

  @@unique([chartId, period])
  @@index([chartId, generatedAt])
  @@map("chart_snapshots")
}

model ChartEntry {
  id           String  @id @default(cuid())
  snapshotId   String
  mediaId      String
  rank         Int
  previousRank Int?
  // rank movement: positive = climbed, negative = fell, null = new entry
  movement     Int?
  isNewEntry   Boolean @default(false)
  peakRank     Int?
  weeksOnChart Int     @default(1)
  score        Float   @default(0)
  snapshot     Json

  chartSnapshot ChartSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  media         MediaItem?    @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@unique([snapshotId, mediaId])
  @@index([snapshotId, rank])
  @@map("chart_entries")
}

// ---------------------------------------------------------------------------
// Behaviour signals
// ---------------------------------------------------------------------------

model SearchHistory {
  id          String   @id @default(cuid())
  userId      String
  domain      Domain
  query       String
  // Structured preferences the query parser extracted.
  parsed      Json?
  resultCount Int      @default(0)
  latencyMs   Int?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("search_history")
}

model RecommendationEvent {
  id        String      @id @default(cuid())
  userId    String?
  domain    Domain
  mediaId   String?
  mediaType MediaType?
  action    EventAction
  query     String?
  score     Float?
  position  Int?
  metadata  Json?
  createdAt DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([mediaId])
  @@map("recommendation_events")
}

model JobRun {
  id         String    @id @default(cuid())
  name       String
  status     JobStatus @default(RUNNING)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?
  processed  Int       @default(0)
  skipped    Int       @default(0)
  failed     Int       @default(0)
  error      String?
  detail     Json?

  @@index([name, startedAt])
  @@map("job_runs")
}
