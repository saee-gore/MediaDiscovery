{
  "name": "curated",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered semantic discovery and curation for music, movies and series.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts",
    "ingest": "tsx scripts/ingest.ts",
    "embed": "tsx scripts/embed.ts",
    "jobs:top50": "tsx scripts/run-job.ts refresh-top-50",
    "jobs:trending": "tsx scripts/run-job.ts refresh-trending",
    "jobs:embeddings": "tsx scripts/run-job.ts backfill-embeddings",
    "jobs:all": "tsx scripts/run-job.ts all",
    "scheduler": "tsx scripts/scheduler.ts",
    "setup": "tsx scripts/migrate.ts && tsx scripts/seed.ts"
  },
  "dependencies": {
    "@langchain/core": "^0.3.80",
    "@langchain/ollama": "^0.2.4",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.10",
    "langchain": "^0.3.37",
    "lucide-react": "^1.34.0",
    "next": "15.5.23",
    "pg": "^8.23.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "tailwindcss": "^4",
    "tsx": "^4.20.7",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
